{
  "manifest_version": 3,
  "name": "JobGuard Autofill",
  "version": "0.2.0",
  "description": "Fills job applications from your JobGuard answer bank. You review and submit; it never clicks Submit.",
  "permissions": ["storage", "activeTab", "scripting", "alarms"],
  "host_permissions": ["http://localhost/*", "https://*.vercel.app/*"],
  "optional_host_permissions": ["https://*/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "JobGuard Autofill" },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://*.myworkdayjobs.com/*",
        "https://boards.greenhouse.io/*",
        "https://job-boards.greenhouse.io/*",
        "https://jobs.lever.co/*",
        "https://jobs.ashbyhq.com/*",
        "https://jobs.smartrecruiters.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
