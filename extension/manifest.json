{
  "manifest_version": 3,
  "name": "JobGuard Autofill",
  "version": "0.3.5",
  "description": "Fills job applications from your JobGuard answers and keeps your job statuses up to date. You review and submit; it never clicks Submit.",
  "permissions": ["storage", "activeTab", "scripting", "alarms"],
  "host_permissions": ["https://jobguard-lemon.vercel.app/*", "http://localhost/*", "https://mail.google.com/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "JobGuard Autofill" },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://*.myworkdayjobs.com/*",
        "https://boards.greenhouse.io/*",
        "https://job-boards.greenhouse.io/*",
        "https://jobs.lever.co/*",
        "https://jobs.ashbyhq.com/*",
        "https://jobs.smartrecruiters.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["https://jobguard-lemon.vercel.app/*", "http://localhost/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["gmail.js"],
      "run_at": "document_idle"
    }
  ]
}
